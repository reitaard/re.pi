{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"*": ["./*"],
			"@reitaard/repi-ai": ["./packages/ai/src/index.ts"],
			"@reitaard/repi-ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@reitaard/repi-ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@reitaard/repi-ai/dist/*": ["./packages/ai/src/*"],
			"@reitaard/repi-agent-core": ["./packages/agent/src/index.ts"],
			"@reitaard/repi-agent-core/node": ["./packages/agent/src/node.ts"],
			"@reitaard/repi-agent-core/*": ["./packages/agent/src/*"],
			"@reitaard/repi-telemetry": ["./packages/telemetry/src/index.ts"],
			"@reitaard/repi-telemetry/*": ["./packages/telemetry/src/*.ts"],
			"@reitaard/repi-storage-sqlite-node": ["./packages/storage/sqlite-node/src/index.ts"],
			"@reitaard/repi-coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@reitaard/repi-coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@reitaard/repi-coding-agent/*": ["./packages/coding-agent/src/*"],
			"@reitaard/repi-orchestrator": ["./packages/orchestrator/src/index.ts"],
			"@reitaard/repi-orchestrator/*": ["./packages/orchestrator/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@reitaard/repi-tui": ["./packages/tui/src/index.ts"],
			"@reitaard/repi-tui/*": ["./packages/tui/src/*"],
			"@reitaard/repi-agent-old": ["./packages/agent-old/src/index.ts"],
			"@reitaard/repi-agent-old/*": ["./packages/agent-old/src/*"]
		}
	},
	"include": [
		"packages/agent/src/**/*",
		"packages/agent/test/**/*",
		"packages/ai/src/**/*",
		"packages/ai/test/**/*",
		"packages/coding-agent/src/**/*",
		"packages/coding-agent/test/**/*",
		"packages/orchestrator/src/**/*",
		"packages/orchestrator/test/**/*",
		"packages/telemetry/src/**/*",
		"packages/telemetry/test/**/*",
		"packages/tui/src/**/*",
		"packages/tui/test/**/*",
		"packages/storage/*/src/**/*",
		"packages/storage/*/test/**/*",
		"packages/coding-agent/examples/**/*"
	],
	"exclude": [
		"**/dist/**",
		"packages/coding-agent/examples/extensions/gondolin/**",
		"packages/coding-agent/src/cli/experimental/**",
		"packages/coding-agent/src/client/**",
		"packages/coding-agent/src/server/**",
		"packages/coding-agent/test/client/**",
		"packages/coding-agent/test/server/**",
		"packages/coding-agent/test/experimental-cli-command.test.ts",
		"packages/coding-agent/test/experimental-cli-resolution.test.ts"
	]
}
