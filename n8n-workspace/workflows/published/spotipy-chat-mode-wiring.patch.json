  "operations": [
    {
      "type": "patchNodeField",
      "nodeName": "Parse Fast input",
      "fieldPath": "parameters.jsCode",
      "patches": [
        {
          "find": "state.fastChats ??= {};",
          "replace": "state.fastChats ??= {};\nstate.chatChats ??= {};"
        },
        {
          "find": "  state.fastChats[chatId] = true;\n  return { intent: 'fastMode', chatId, messageId };",
          "replace": "  state.fastChats[chatId] = true;\n  delete state.chatChats[chatId];\n  return { intent: 'fastMode', chatId, messageId };"
        },
        {
          "find": "if (/^\\/chat(?:@\\w+)?$/i.test(text)) {\n  delete state.fastChats[chatId];\n  return { intent: 'chatMode', chatId, messageId };\n}",
          "replace": "if (/^\\/chat(?:@\\w+)?$/i.test(text)) {\n  state.chatChats[chatId] = true;\n  delete state.fastChats[chatId];\n  return { intent: 'chatMode', chatId, messageId };\n}"
        },
        {
          "find": "if (state.fastChats[chatId] && text && !text.startsWith('/')) {\n  return { intent: 'search', chatId, messageId, query: text.slice(0, 500), payloadB64: buildPayload('quickSearch', text.slice(0, 500)) };\n}\n",
          "replace": "if (state.chatChats[chatId] && text && !text.startsWith('/')) {\n  return { intent: 'chat', chatId, messageId, query: text.slice(0, 500) };\n}\nif (state.fastChats[chatId] && text && !text.startsWith('/')) {\n  return { intent: 'search', chatId, messageId, query: text.slice(0, 500), payloadB64: buildPayload('quickSearch', text.slice(0, 500)) };\n}\n"
        },
        {
          "find": "return { intent: 'help', chatId, messageId, help: 'Send /fast, then send a song name. Tap one of the ten results to download that exact source.' };",
          "replace": "return { intent: 'help', chatId, messageId, help: 'Use /fast to download music, or /chat to talk with Spotipy.' };"
        }
      ]
    },
    {
      "type": "updateNode",
      "nodeName": "Route Fast input",
      "updates": {
        "parameters.rules": {
